{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    ".agents/**",
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "package-lock.json",
    "vendor/kop-xiao/**"
  ]
}
